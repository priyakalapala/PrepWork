pipeline {
    agent any
    
    environment {
        APP_NAME   = "Priya_App"
        APP_ENV    = "Production"
        REGION     = "us-east-1"
        BUILD_TYPE = "Debug"
    }
    stages {
        stage('Print Variables') {
            steps {
                echo "APP_NAME  = ${env.APP_NAME}"
                echo "APP_ENV   = ${env.APP_ENV}"
                echo "REGION    = ${env.REGION}"
                echo "BUILD_TYPE = ${env.BUILD_TYPE}"
            }
        }
    }
}


pipeline {
    agent any
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'kalapalaMain', description: 'Branch to build')
        string(name: 'First_Name', defaultValue: 'Lakshmi Priya', description: 'Branch to build')
    }
    stages {
        stage('Checkout') {
            steps {
                echo "Building branch: ${params.BRANCH_NAME}"
            }
        }
         stage('Deploy') {
            steps {
                echo "Deploying branch to environment: ${params.First_Name}"
            }
        }
    }
}

pipeline {
agent any
stages {
stage('Build') {
    steps {
        withEnv(["APP_NAME=MyApp", "APP_ENV=Test"]) {
             echo "Building $APP_NAME in $APP_ENV environment"
        }
    }
}
}
}

pipeline {
    agent any
    stages {
        stage('build') {
            steps {
                withEnv(["APP_NAME =priya", "APP_ENV = Deploy"]) {
                    echo "Building $APP_NAME in $APP_ENV environment"
                }
            }
        }

    }
}
    
pipeline {
agent any
stages {
     stage('Branch Deploy') {
         steps {
             script {
                 
            if (env.BRANCH_NAME == "main") {
            withEnv(["DEPLOY_ENV=production"]) {
                echo "Deploying to $DEPLOY_ENV"
            }
        } 
        else {
            withEnv(["DEPLOY_ENV=staging"]) {
                echo "Deploying to $DEPLOY_ENV"
            }
        }
    }
 }
}
}
}


